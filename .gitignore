# 图片原始素材（AI 生成的高分辨率 PNG，约 88MB）
# 已裁切压缩进 assets/images/，不属于网站发布内容，不入库
/raw-images/

# 项目工作记忆目录
/.workbuddy/

# 中间产物与临时文件（生成过程留档，不属于站点发布内容）
__pycache__/
*.pyc
*.tmp
*.bak
*.orig
*.rej

# 单篇文章的一次性生成脚本（正文、索引接线），用完即弃，不入库
# 可复用的工具脚本（check.py / nav_sync.py / blog_images.py / related_sync.py
# / audit_page.py）照常入库
scripts/build_*.py
scripts/wire_*.py

# 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
